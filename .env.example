# FitNova SaaS Environment Configuration

# Django Core Settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=fitnova-production-2026-secret-key-for-render-deployments-9273f8e1a2b7c4d6
ALLOWED_HOSTS=*

# PostgreSQL Database Configuration
# Option A: Localhost parameters
DB_NAME=fitnova_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Option B: Full Database URL (Render / Supabase / Neon / Cloud)
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/fitnova_db

# Fallback switch (set to True only if running tests without PostgreSQL service)
USE_SQLITE=False
